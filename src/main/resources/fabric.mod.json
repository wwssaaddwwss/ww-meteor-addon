{
  "schemaVersion": 1,
  "id": "wwss-addon",
  "version": "${version}",
  "name": "wwss Template",
  "description": "Meteor Addon from wwssaaddwwss",
  "authors": [
    "wwssaaddwwss"
  ],
  "contact": {
    "sources": "https://https://github.com/wwssaaddwwss/ww-meteor-addon"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
